#include "sawbuck_version.h"
#include "afxres.h"

#ifdef APSTUDIO_INVOKED
#error Don't open this file in the GUI, it'll be massacred on save.
#endif  // APSTUDIO_INVOKED

/////////////////////////////////////////////////////////////////////////////
// English (U.S.) resources
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Version
//
VS_VERSION_INFO VERSIONINFO
 FILEVERSION SAWBUCK_MAJOR,SAWBUCK_MINOR,SAWBUCK_BUILD,SAWBUCK_PATCH
 PRODUCTVERSION SAWBUCK_MAJOR,SAWBUCK_MINOR,SAWBUCK_BUILD,SAWBUCK_PATCH
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK // 0x0000003F
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG // 0x00000001L
#else
 FILEFLAGS 0x00000000L // VS_FF_RELEASE
#endif
 FILEOS VOS_NT_WINDOWS32 // 0x00040004L
 FILETYPE VFT_APP // 0x00000001L
 FILESUBTYPE VFT2_UNKNOWN // 0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // 0x0409 = US English, 0x04B0 = Unicode (1200)
        BEGIN
            VALUE "FileDescription",  "Sawbuck Log Viewer"
            VALUE "FileVersion",      SAWBUCK_VER_STR
            VALUE "InternalName",     "sawbuck" // Not capitalized or with file ext
            VALUE "LegalCopyright",   "Copyright (c) 2026 Alex313031 and Google Inc"
            VALUE "LegalTrademarks",  "Apache 2.0 License"
            VALUE "CompanyName",      "Alex313031"
            VALUE "OriginalFilename", "Sawbuck.exe"
            VALUE "ProductName",      "Sawbuck Log Viewer"
            VALUE "ProductVersion",   SAWBUCK_VER_STR
            VALUE "Comments",         "https://github.com/Alex313031/sawbuck-ng" // Github repo
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
