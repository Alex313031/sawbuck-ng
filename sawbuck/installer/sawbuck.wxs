<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <!-- Version information -->
  <?include 'version.wxi' ?>

  <?define ProductVersion="$(var.VER_MAJOR).$(var.VER_MINOR).$(var.VER_BUILD).$(var.VER_PATCH)" ?>
  <?define RTMProductVersion="0.5.0.0" ?>
  <?define UpgradeCode="{EC758BD3-1E77-4b54-A464-38824F53BCAF}" ?>

  <!--
    Architecture. installer.gyp passes MsiPlatform straight from MSBuild's
    $(Platform), so it arrives as Win32 or x64 rather than in WiX's spelling,
    and everything that varies by architecture is derived here instead of
    being repeated at each use.

    A 64-bit package is more than a flag on Package. Its components have to be
    marked Win64 so their files land in ProgramFiles64Folder and their
    registry writes go to the native view rather than WOW6432Node. Mixing
    64-bit and 32-bit components in one package is a hard error (ICE80), so
    all of this moves together.

    The component GUIDs differ per architecture on purpose. A component GUID
    is supposed to identify one resource at one path, and these install to
    different directories in each package. Sharing them would break that,
    and this product schedules RemoveExistingProducts after InstallFinalize,
    so during a cross-architecture upgrade both products are briefly
    registered at once, which is exactly when a shared GUID with two paths
    misbehaves.

    SystemFolder also inverts between the two: in a 32-bit package it is the
    32-bit system directory and System64Folder is the native one, and in a
    64-bit package that is reversed. Either msiexec.exe can uninstall either
    package, but naming the matching one per architecture keeps the shortcut
    honest.
  -->
<?if $(var.MsiPlatform) = x64 ?>
  <?define PackagePlatform = "x64" ?>
  <?define ComponentWin64 = "yes" ?>
  <?define ProgramFilesFolderId = "ProgramFiles64Folder" ?>
  <?define SystemFolderId = "System64Folder" ?>
  <?define SawbuckShortcutGuid = "{34F5DEE2-7DF4-4608-B3C2-D9741DAE17F2}" ?>
  <?define ProviderRegistryGuid = "{B387E993-64EA-499C-8B80-689B1121C5CF}" ?>
  <?define SawbuckExeGuid = "{B3560AF7-C830-488D-A173-1E0014499A5D}" ?>
  <?define IcuDataGuid = "{253DD73D-B5F4-4011-BC89-DAFE0F7686F1}" ?>
  <?define DbgHelpDllGuid = "{713A98CF-AF3A-4B98-ADB1-F3EB7A41E0EA}" ?>
  <?define SymSrvDllGuid = "{9FA4D779-083B-4DD3-BD4E-DAB728B61BA9}" ?>
<?else?>
  <?define PackagePlatform = "x86" ?>
  <?define ComponentWin64 = "no" ?>
  <?define ProgramFilesFolderId = "ProgramFilesFolder" ?>
  <?define SystemFolderId = "SystemFolder" ?>
  <?define SawbuckShortcutGuid = "{CECB7B52-78A8-4638-BD25-0CFD2F0044DF}" ?>
  <?define ProviderRegistryGuid = "{1161AE44-89DE-4144-882A-E98C389C4F07}" ?>
  <?define SawbuckExeGuid = "{8F825656-7F0D-4aa6-A22C-759F82D47E38}" ?>
  <?define IcuDataGuid = "{54A35C00-08A8-4F95-9155-A970D4C52905}" ?>
  <?define DbgHelpDllGuid = "{CDDFC08A-5814-4375-9971-2B35A039B72F}" ?>
  <?define SymSrvDllGuid = "{04FFB025-E3C9-4ecd-8255-ED7E63EFC948}" ?>
<?endif?>

  <Product Id='*'
      Name='Sawbuck'
      Language='1033'
      Version='$(var.ProductVersion)'
      Manufacturer='Alex313031'
      UpgradeCode='$(var.UpgradeCode)' >
    <Package Description='The Chromium Log Viewer.'
             Platform='$(var.PackagePlatform)'
             Manufacturer='Alex313031'
             InstallerVersion='200'
             Compressed='yes' />

    <!--
      The oldest Windows this package will install on, stated rather than left
      implied. InstallerVersion above is 200, which is the Windows Installer
      version XP ships with and is what lets this run there at all; it says
      nothing about the floor, so without a launch condition the package would
      attempt Windows 2000 and earlier and fail somewhere less legible than a
      message box.

      The numbers match the subsystem versions viewer.gyp links with, and for
      the same reasons. VersionNT is encoded as major * 100 + minor, so 501 is
      XP and 502 is Server 2003, which is also what 64-bit XP reports, being
      built on the Server 2003 codebase. Hence 502 for the x64 package: there
      is no 64-bit Windows older than that, exactly as the linker's /SUBSYSTEM
      floor cannot go below 5.02 for that machine.

      VersionNT64 rather than VersionNT in the 64-bit package, which is the
      property that is only set at all on 64-bit Windows. An unset property
      compares as empty and fails the test, so a 32-bit machine is refused with
      this message instead of whatever msiexec says about the platform.

      Written out per architecture rather than substituted from a define: the
      expression contains a '>' and lives in CDATA, and literal text here needs
      no preprocessor variable resolution to be correct.
    -->
<?if $(var.MsiPlatform) = x64 ?>
    <Condition Message='Sawbuck requires Windows XP x64 / Server 2003 or newer.'>
      <![CDATA[VersionNT64 >= 502]]>
    </Condition>
<?else?>
    <Condition Message='Sawbuck requires Windows XP or newer.'>
      <![CDATA[VersionNT >= 501]]>
    </Condition>
<?endif?>

    <!--
      Boilerplate code to make sure we upgrade previous versions,
      and to prevent downgrades for good measure.
    -->
    <Upgrade Id="$(var.UpgradeCode)">
      <UpgradeVersion Minimum="$(var.ProductVersion)"
                      IncludeMinimum="no"
                      OnlyDetect="yes"
                      Language="1033"
                      Property="NEWPRODUCTFOUND" />
      <UpgradeVersion Minimum="$(var.RTMProductVersion)"
                      IncludeMinimum="yes"
                      Maximum="$(var.ProductVersion)"
                      IncludeMaximum="no"
                      Language="1033"
                      Property="UPGRADEFOUND" />
    </Upgrade>

    <!--
      Prevent downgrading.
    -->
    <CustomAction Id="PreventDowngrading"
                  Error="Newer version already installed." />

    <InstallExecuteSequence>
      <Custom Action="PreventDowngrading"
              After="FindRelatedProducts">NEWPRODUCTFOUND</Custom>
      <RemoveExistingProducts After="InstallFinalize" />
    </InstallExecuteSequence>

    <InstallUISequence>
      <Custom Action="PreventDowngrading"
              After="FindRelatedProducts">NEWPRODUCTFOUND</Custom>
    </InstallUISequence>

    <!--
      Use the install dir UI which displays our license agreement,
      and also allows the user to pick the install location.
    -->
    <Property Id='WIXUI_INSTALLDIR' Value='SAWBUCKAPPLICATIONDIRECTORY' />
    <UI>
      <UIRef Id='WixUI_InstallDir' />
      <Publish Dialog="ExitDialog"
          Control="Finish"
          Event="DoAction"
          Value="LaunchApplication">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Publish>
    </UI>

    <!--
      Specify our license file.
    -->
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!--
      Add an option to launch Sawbuck at the end of installation, ticked.
      This is all boilerplate from WiX docs.

      An MSI CheckBox renders ticked when its property holds any non-empty
      value, so giving WIXUI_EXITDIALOGOPTIONALCHECKBOX one up front is the
      whole of "launch by default"; everything else was already here. The
      control writes 1 back when ticked, which is what the Publish above tests
      for.

      Two things this deliberately does not change. The name is all capitals,
      so it is a public property and an unattended install can still decline:
      msiexec /i Sawbuck_x86.msi WIXUI_EXITDIALOGOPTIONALCHECKBOX=0. And a
      silent install never launches anything regardless, because the Publish
      that runs LaunchApplication belongs to the UI sequence, which /qn does
      not execute. A silent install that started a GUI would be a poor
      surprise.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
        Value="Launch Sawbuck" />

    <Property Id="WixShellExecTarget" Value="[#SawbuckExeFile]" />
    <CustomAction Id="LaunchApplication"
        BinaryKey="WixCA"
        DllEntry="WixShellExec"
        Impersonate="yes" />

    <Media Id='1' Cabinet='product.cab' EmbedCab='yes' />

    <!--
      Declare our Add/Remove Programs icon.
    -->
    <Icon Id="icon.ico" SourceFile="..\viewer\sawbuck.ico" />
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />

    <!-- Define our program files foler -->
    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='$(var.ProgramFilesFolderId)'>
        <Directory Id='ProgramFilesVendorFolder' Name='Alex313031'>
          <Directory Id='SAWBUCKAPPLICATIONDIRECTORY' Name='Sawbuck' />
        </Directory>
      </Directory>

      <!-- Define our application files folder -->
      <Directory Id='ProgramMenuFolder'>
        <Directory Id='SawbuckProgramsDirectory' Name='Sawbuck' />
      </Directory>
    </Directory>

    <!-- Component for the application start menu shortcut -->
    <DirectoryRef Id='SawbuckProgramsDirectory'>
      <Component Id='SawbuckShortcutComponent'
          Guid='$(var.SawbuckShortcutGuid)'
          Win64='$(var.ComponentWin64)'>
        <Shortcut Id='ApplicationStartMenuShortcut'
                  Name='Sawbuck'
                  Description='The Chromium log viewer.'
                  Target='[SAWBUCKAPPLICATIONDIRECTORY]Sawbuck.exe'
                  WorkingDirectory='SAWBUCKAPPLICATIONDIRECTORY' />
        <RemoveFolder Id='SawbuckProgramsDirectory' On='uninstall' />
        <!-- This is apparently necessary so the component has
            a 'key' item.
        -->
        <RegistryValue
            Root='HKCU'
            Key='Software\Alex313031\Sawbuck'
            Name='installed'
            Type='integer'
            Value='1'
            KeyPath='yes' />
        <!--
          Put an uninstall shortcut in there as well.

          SystemFolder, not System64Folder: this is a 32-bit package, and
          System64Folder is only defined on 64-bit Windows, so on a 32-bit
          install the shortcut pointed at nothing. SystemFolder resolves to
          SysWOW64 on x64 and System32 on x86, and msiexec.exe in either is
          the right one to hand a ProductCode to.
        -->
        <Shortcut Id='UninstallSawbuckShortcut'
                  Name='Uninstall Sawbuck'
                  Target='[$(var.SystemFolderId)]msiexec.exe'
                  Arguments='/x [ProductCode]'
                  Description='Uninstalls Sawbuck' />
      </Component>
    </DirectoryRef>

    <!-- Provider registration component. -->
    <DirectoryRef Id='TARGETDIR'>
      <Component Id='ProviderRegistryComponent'
          Guid='$(var.ProviderRegistryGuid)'
          Win64='$(var.ComponentWin64)'>
        <RegistryKey
            Root='HKLM'
            Key='Software\Alex313031\Sawbuck\Providers'
            Action='createAndRemoveOnUninstall'>
          <!--
              All the log providers that use Chrome base logging are
              defined with single common include file.
          -->
          <!--
              Named for the engine rather than any one browser, because this
              single entry covers every Chromium-based browser that builds
              chrome/: Chromium, Google Chrome, Thorium and so on. They all
              share this GUID, which is hard-coded as kChromeTraceProviderName
              in chrome/common/logging_chrome.cc and registered
              unconditionally by InitChromeLogging.

              So there is deliberately no separate Thorium or Chrome entry:
              the key name under Providers *is* the GUID, which makes a second
              key for the same provider inexpressible, and meaningless if it
              were not.

              Electron is the exception, and is not covered. It does not build
              chrome/ and never calls LogEventProvider::Initialize, so it
              registers no ETW provider at all and nothing here can surface
              its logs.
          -->
          <?define LogProviderName = 'Chromium'?>
          <?define LogProviderGUID = '{7FE69228-633E-4f06-80C1-527FEA23E3A7}'?>
          <?include chrome_log_provider.wxi?>

          <!-- Sawbuck, we default to ERROR level only for our own logs. -->
          <?define LogProviderDefaultLevel = '1'?>
          <?define LogProviderName = 'Sawbuck'?>
          <?define LogProviderGUID = '{C43B1318-C63D-465b-BCF4-7A89A369F8ED}'?>
          <?include chrome_log_provider.wxi?>

          <!-- Chrome Setup -->
          <?define LogProviderName = 'Chrome Setup'?>
          <?define LogProviderGUID = '{93BCE0BF-3FAF-43b1-9E28-BEB6FAB5ECE7}'?>
          <?include chrome_log_provider.wxi?>

          <!-- Chrome Perf trace provider -->
          <RegistryKey
              Key='{3DADA31D-19EF-4dc1-B345-037927193422}'>
            <RegistryValue
                Type='string'
                Value='Chrome Perf Traces' />
            <RegistryValue
                Name='default_level'
                Type='integer'
                Value='0' />
            <RegistryValue
                Name='default_flags'
                Type='integer'
                Value='0' />
          </RegistryKey>
          <!-- Omaha -->
          <RegistryKey
              Key='{9B18BFF9-915E-4cc1-9C3E-F4AC112CB36C}'>
            <RegistryValue
                Type='string'
                Value='Omaha' />
            <RegistryValue
                Name='default_level'
                Type='integer'
                Value='4' />
            <RegistryValue
                Name='default_flags'
                Type='integer'
                Value='4095' />
            <RegistryKey
                Key='Flags'>
              <RegistryKey
                  Key='Stack Trace'>
                <RegistryValue
                    Type='integer'
                    Value='1' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_LOGGING'>
                <RegistryValue
                    Type='integer'
                    Value='2' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_UTIL'>
                <RegistryValue
                    Type='integer'
                    Value='4' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_SETUP'>
                <RegistryValue
                    Type='integer'
                    Value='8' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_SHELL'>
                <RegistryValue
                    Type='integer'
                    Value='16' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_CORE'>
                <RegistryValue
                    Type='integer'
                    Value='32' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_JS'>
                <RegistryValue
                    Type='integer'
                    Value='64' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_PLUGIN'>
                <RegistryValue
                    Type='integer'
                    Value='128' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_SERVICE'>
                <RegistryValue
                    Type='integer'
                    Value='256' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_OPT'>
                <RegistryValue
                    Type='integer'
                    Value='512' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_NET'>
                <RegistryValue
                    Type='integer'
                    Value='1024' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_REPORT'>
                <RegistryValue
                    Type='integer'
                    Value='2048' />
              </RegistryKey>
              <RegistryKey
                  Key='LC_ALL'>
                <RegistryValue
                    Type='integer'
                    Value='4094' />
              </RegistryKey>
            </RegistryKey>
          </RegistryKey>

          <!-- IE Toolbar -->
          <RegistryKey
              Key='{79FDF710-2D7F-488f-B00C-C6EFAE507169}'>
            <RegistryValue Type='string' Value='IE Toolbar' />
            <RegistryValue
                Name='default_level'
                Type='integer'
                Value='4' />
            <RegistryValue
                Name='default_flags'
                Type='integer'
                Value='1' />
            <RegistryKey
                Key='Flags'>
              <RegistryKey
                  Key='Stack Trace'>
                <RegistryValue
                    Type='integer'
                    Value='1' />
              </RegistryKey>
            </RegistryKey>
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <!-- Component for the application's EXE -->
    <DirectoryRef Id='SAWBUCKAPPLICATIONDIRECTORY'>
      <Component Id='SawbuckExeComponent'
          Guid='$(var.SawbuckExeGuid)'
          Win64='$(var.ComponentWin64)'>
        <File Id='SawbuckExeFile'
            Name='Sawbuck.exe'
            DiskId='1'
            Source='$(var.SAWBUCK_EXE_PATH)' />
        <!--
          Kept as insurance for running Sawbuck against old Chromium builds,
          not because anything is known to need it.

          chrome/common/logging_chrome.cc was checked at 8.0.552.237 (2010,
          contemporaneous with this installer), 14.0.835.202, 23.0.1271.64,
          37.0.2062.120, the M49 branch point and tip of tree. CHROME_ETW_LOGGING
          appears in none of them, and every one calls
          LogEventProvider::Initialize(kChromeTraceProviderName) unconditionally
          under OS_WIN. So the ETW provider registers regardless and there is
          nothing for this variable to switch on.

          System='no' deliberately: the original set this machine-wide, which
          wrote shared state and, per the comment it carried, could need a
          logout before taking effect. Per-user costs nothing and WiX
          broadcasts WM_SETTINGCHANGE, so newly launched processes see it.
        -->
        <Environment Id='ChromeEtwLoggingEnvVar'
            Action='create'
            System='no'
            Name='CHROME_ETW_LOGGING'
            Value='1' />
      </Component>
      <!--
        ICU's data, as a file rather than a DLL.

        build/common.gypi sets icu_use_data_file_flag to 1, which makes
        base.gyp compile base with ICU_UTIL_DATA_IMPL=ICU_UTIL_DATA_FILE, so
        base::i18n::InitializeICU() loads icudtl.dat from the directory
        holding the executable. icu.gyp's copy_icudtl_dat target puts it
        beside Sawbuck.exe for a build-tree run; this does the same for an
        installed one.

        This component used to ship third_party/icu/windows/icudt.dll, which
        nothing loads; the DLL form is only used when icu_use_data_file_flag
        is 0. An installed Sawbuck therefore had no ICU data at all.

        The GUID is new on purpose. The component's key path changes, and
        RemoveExistingProducts runs After InstallFinalize, so the old product
        is uninstalled *after* the new one is in place: reusing the GUID would
        have that uninstall operate on a component whose key path had moved
        under it. A fresh GUID leaves the old component unreferenced, so
        icudt.dll is removed cleanly and icudtl.dat is never considered.
      -->
      <Component Id='IcuDataComponent'
          Guid='$(var.IcuDataGuid)'
          Win64='$(var.ComponentWin64)'>
        <File Id='IcuDataFile'
            Name='icudtl.dat'
            DiskId='1'
            Source='..\..\third_party\icu\source\data\in\icudtl.dat' />
      </Component>

      <!--
        DbgHelp.dll and SymSrv.dll are taken from the build output rather than
        straight out of third_party, the same way Sawbuck.exe is. They exist
        in per-architecture flavours, and viewer.gyp's copy_dlls has already
        put the ones matching the build beside the executable, so sourcing
        them from there makes the installer follow the architecture
        automatically instead of needing its own idea of which set to pick.
        installer.gyp passes the two paths in as candle defines.

        No DbgCore.dll. The 6.12.2.633 set shipped by default predates the
        minidump APIs being split out of DbgHelp, so there is no such file,
        and the 10.0.26100 set does not need one shipped either: DbgHelp's
        MiniDumpWriteDump and MiniDumpReadDumpStream exports are forwarders to
        DbgCore, which the loader resolves only for a caller that imports
        those two functions from DbgHelp. Nothing in Sawbuck or Chromium base
        does, so the forwarders are never followed.
      -->
      <Component Id='DbgHelpDllComponent'
          Guid='$(var.DbgHelpDllGuid)'
          Win64='$(var.ComponentWin64)'>
        <File Id='DbgHelpDllFile'
            Name='DbgHelp.dll'
            DiskId='1'
            Source='$(var.DBGHELP_DLL_PATH)' />
      </Component>
      <Component Id='SymSrvDllComponent'
          Guid='$(var.SymSrvDllGuid)'
          Win64='$(var.ComponentWin64)'>
        <File Id='SymSrvDllFile'
            Name='SymSrv.dll'
            DiskId='1'
            Source='$(var.SYMSRV_DLL_PATH)' />
      </Component>
    </DirectoryRef>

    <!-- Just one feature. No muss no fuss, no UI. -->
    <Feature Id='Sawbuck' Title='Sawbuck Log Viewer' Level='1'>
      <ComponentRef Id='SawbuckExeComponent' />
      <ComponentRef Id='IcuDataComponent' />
      <ComponentRef Id='SawbuckShortcutComponent' />
      <ComponentRef Id='ProviderRegistryComponent' />
      <ComponentRef Id='DbgHelpDllComponent' />
      <ComponentRef Id='SymSrvDllComponent' />
    </Feature>
  </Product>
</Wix>
